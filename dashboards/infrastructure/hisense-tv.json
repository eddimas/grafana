    {
      "id": 9,
      "type": "stat",
      "title": "IP del cable",
      "description": "La IP fija configurada en el Ethernet de la TV responde desde otro equipo. Cambia el Ethernet de la TV a DHCP.",
      "datasource": "Loki",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 21,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "—",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 1000000000.0,
                "result": {
                  "text": "CONFLICTO"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "sum(count_over_time({job=\"tv-monitor\", host=~\"$host\"} | json c=\"network.ethernet.ip_conflict\" | c=\"true\" [10m]))",
          "refId": "A",
          "legendFormat": "",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
