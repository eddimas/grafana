    {
      "id": 11,
      "type": "timeseries",
      "title": "Latencia promedio por destino",
      "description": "Router alto = problema de Wi-Fi/cable local. Router bien + Internet alto = ISP o VPN.",
      "datasource": "Loki",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "avg(avg_over_time({job=\"tv-monitor\", host=~\"$host\"} | json v=\"ping.gateway.avg_ms\" | unwrap v | __error__=\"\" [3m]))",
          "refId": "A",
          "legendFormat": "Router"
        },
        {
          "datasource": "Loki",
          "expr": "avg(avg_over_time({job=\"tv-monitor\", host=~\"$host\"} | json v=\"ping.adguard.avg_ms\" | unwrap v | __error__=\"\" [3m]))",
          "refId": "B",
          "legendFormat": "AdGuard"
        },
        {
          "datasource": "Loki",
          "expr": "avg(avg_over_time({job=\"tv-monitor\", host=~\"$host\"} | json v=\"ping.internet.avg_ms\" | unwrap v | __error__=\"\" [3m]))",
          "refId": "C",
          "legendFormat": "Internet (1.1.1.1)"
        },
        {
          "datasource": "Loki",
          "expr": "avg(avg_over_time({job=\"tv-monitor\", host=~\"$host\"} | json v=\"ping.vpn.avg_ms\" | unwrap v | __error__=\"\" [3m]))",
          "refId": "D",
          "legendFormat": "Servidor VPN"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
