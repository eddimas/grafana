{
  "uid": "hisense-tv",
  "title": "Hisense TV (Google TV)",
  "description": "Salud y red de la TV vía tv-monitor (ADB desde raspberrypi-prod → Loki). Fuente: eddimas/tv_apps.",
  "tags": [
    "infrastructure",
    "logs",
    "loki",
    "tv",
    "raspberry",
    "network"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 42,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": "Loki",
        "query": "label_values({job=\"tv-monitor\"}, host)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [
    {
      "title": "Network Health",
      "type": "link",
      "url": "/d/network-health-overview"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Estado actual",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "TV / ADB",
      "description": "Recolecciones exitosas en los últimos 5 min. 'Sin respuesta' = TV apagada, IP cambiada o llave ADB no autorizada.",
      "datasource": "Loki",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "—",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 1000000000.0,
                "result": {
                  "text": "En línea"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Sin respuesta"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "sum(count_over_time({job=\"tv-monitor\", host=~\"$host\", success=\"true\"}[5m]))",
          "refId": "A",
          "legendFormat": "",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Conexión",
      "description": "",
      "datasource": "Loki",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 3,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "—",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "wifi": {
                  "text": "Wi-Fi",
                  "color": "blue"
                },
                "ethernet": {
                  "text": "Cable",
                  "color": "green"
                },
                "none": {
                  "text": "Sin red",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "sum by (network) (count_over_time({job=\"tv-monitor\", host=~\"$host\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{network}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "name",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "VPN",
      "description": "",
      "datasource": "Loki",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "—",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "true": {
                  "text": "Activa",
                  "color": "green"
                },
                "false": {
                  "text": "Apagada",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "sum by (vpn) (count_over_time({job=\"tv-monitor\", host=~\"$host\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{vpn}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "name",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Señal Wi-Fi",
      "description": "≥ -55 excelente · -67 buena · -75 regular · peor = mala",
      "datasource": "Loki",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 9,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "noValue": "—",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": -75
              },
              {
                "color": "yellow",
                "value": -67
              },
              {
                "color": "green",
                "value": -55
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "max(max_over_time({job=\"tv-monitor\", host=~\"$host\"} | json v=\"network.wifi.rssi_dbm\" | unwrap v | __error__=\"\" [3m]))",
          "refId": "A",
          "legendFormat": "",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
