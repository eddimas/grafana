{
  "id": null,
  "uid": "grafana-observability",
  "title": "Grafana Observability",
  "tags": [
    "grafana",
    "prometheus",
    "kubernetes",
    "infrastructure"
  ],
  "timezone": "browser",
  "schemaVersion": 42,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Grafana Instances",
      "type": "stat",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(grafana_build_info) or sum(grafana_info) or sum(up{namespace=\"grafana-dev\", pod=~\".*grafana.*\"}) or vector(0)",
          "legendFormat": "instances"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Grafana Dashboards",
      "type": "stat",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(grafana_stat_totals_dashboard) or sum(grafana_stat_total_dashboards) or vector(0)",
          "legendFormat": "dashboards"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "Grafana Users",
      "type": "stat",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(grafana_stat_total_users) or vector(0)",
          "legendFormat": "users"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 4,
      "title": "Grafana Playlists",
      "type": "stat",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(grafana_stat_total_playlists) or vector(0)",
          "legendFormat": "playlists"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      }
    },
    {
      "id": 5,
      "title": "Grafana Version",
      "type": "table",
      "targets": [
        {
          "refId": "A",
          "expr": "topk(1, grafana_build_info or grafana_info)",
          "legendFormat": "{{version}}"
        }
      ],
      "transformations": [
        {
          "id": "seriesToRows",
          "options": {
            "reducers": []
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 6,
      "title": "HTTP Requests by Status",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_code) (rate(grafana_http_request_duration_seconds_count[5m]))",
          "legendFormat": "{{status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "gridPos": {
        "h": 7,
        "w": 9,
        "x": 6,
        "y": 5
      }
    },
    {
      "id": 7,
      "title": "HTTP Request P95",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(grafana_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        }
      },
      "gridPos": {
        "h": 7,
        "w": 9,
        "x": 15,
        "y": 5
      }
    },
    {
      "id": 8,
      "title": "Most Used Handlers",
      "type": "table",
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (handler) (rate(grafana_http_request_duration_seconds_count[5m])))",
          "legendFormat": "{{handler}}"
        }
      ],
      "transformations": [
        {
          "id": "seriesToRows",
          "options": {
            "reducers": []
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      }
    },
    {
      "id": 9,
      "title": "Grafana Active Alerts",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (grafana_alerting_active_alerts)",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 12
      }
    },
    {
      "id": 10,
      "title": "Prometheus Alerts",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "firing"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 12
      }
    },
    {
      "id": 11,
      "title": "Grafana Pod CPU",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"grafana-dev\", pod=~\".*grafana.*\", image!=\"\"}[5m])) or vector(0)",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "min": 0
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 20
      }
    },
    {
      "id": 12,
      "title": "Grafana Pod Memory",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"grafana-dev\", pod=~\".*grafana.*\", image!=\"\"}) or vector(0)",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 20
      }
    },
    {
      "id": 13,
      "title": "Grafana Pod Restarts (1h)",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"grafana-dev\", pod=~\".*grafana.*\"}[1h])) or vector(0)",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 20
      }
    }
  ]
}
