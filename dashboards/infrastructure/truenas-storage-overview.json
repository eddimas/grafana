{
  "id": null,
  "uid": "truenas-storage-overview",
  "title": "TrueNAS Storage Overview",
  "tags": ["infrastructure", "storage", "truenas", "node-exporter"],
  "timezone": "browser",
  "schemaVersion": 42,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "System Status",
      "type": "stat",
      "targets": [
        {
          "refId": "A",
          "expr": "up{instance=\"truenas\"}",
          "legendFormat": "Status"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        },
        "graphMode": "none",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Total Memory",
      "type": "stat",
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemTotal_bytes{instance=\"truenas\"} / 1024^3",
          "legendFormat": "GB"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        },
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "CPU Cores",
      "type": "stat",
      "targets": [
        {
          "refId": "A",
          "expr": "node_cpu_cores{instance=\"truenas\"}",
          "legendFormat": "Cores"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        },
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      }
    },
    {
      "id": 4,
      "title": "Storage Usage %",
      "type": "gauge",
      "targets": [
       {
         "refId": "A",
         "expr": "100 * (node_filesystem_used_bytes{instance=\"truenas\", fstype=\"zfs\"} / node_filesystem_size_bytes{instance=\"truenas\", fstype=\"zfs\"})",
         "legendFormat": "Usage %"
       }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 5,
      "title": "Total Storage Capacity",
      "type": "stat",
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_size_bytes{instance=\"truenas\", fstype=\"zfs\"} / 1024^4",
          "legendFormat": "TB"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        },
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 2
        }
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 0
      }
    },
    {
      "id": 6,
      "title": "Storage Available",
      "type": "stat",
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{instance=\"truenas\", fstype=\"zfs\"} / 1024^4",
          "legendFormat": "TB"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        },
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 5
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      }
    },
    {
      "id": 7,
      "title": "Storage Usage Timeline",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_used_bytes{instance=\"truenas\", fstype=\"zfs\"} / 1024^4",
          "legendFormat": "Used (TB)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          }
        }
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 8,
      "title": "Storage Available Timeline",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{instance=\"truenas\", fstype=\"zfs\"} / 1024^4",
          "legendFormat": "Available (TB)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          }
        }
      },
      "options": {
        "legend": {
          "calcs": ["mean", "min"],
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      }
    },
    {
      "id": 9,
      "title": "System Memory Usage",
      "type": "gauge",
      "targets": [
        {
          "refId": "A",
          "expr": "100 * ((node_memory_MemTotal_bytes{instance=\"truenas\"} - node_memory_MemAvailable_bytes{instance=\"truenas\"}) / node_memory_MemTotal_bytes{instance=\"truenas\"})",
          "legendFormat": "Memory %"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      }
    },
    {
      "id": 10,
      "title": "System Load Average",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "expr": "node_load1{instance=\"truenas\"}",
          "legendFormat": "Load 1m"
        },
        {
          "refId": "B",
          "expr": "node_load5{instance=\"truenas\"}",
          "legendFormat": "Load 5m"
        },
        {
          "refId": "C",
          "expr": "node_load15{instance=\"truenas\"}",
          "legendFormat": "Load 15m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          }
        }
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      }
    },
    {
      "id": 11,
      "title": "Memory Available Timeline",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes{instance=\"truenas\"} / 1024^3",
          "legendFormat": "Available (GB)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          }
        }
      },
      "options": {
        "legend": {
          "calcs": ["mean", "min"],
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      }
    },
    {
      "id": 12,
      "title": "Boot Time",
      "type": "stat",
      "targets": [
        {
          "refId": "A",
          "expr": "time() - node_boot_time_seconds{instance=\"truenas\"}",
          "legendFormat": "Uptime"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        },
        "graphMode": "none"
      },
       "fieldConfig": {
         "defaults": {
           "unit": "durationhms",
           "min": 0
         }
       },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      }
    }
  ]
}
