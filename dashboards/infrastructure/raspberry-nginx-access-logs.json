        "w": 6,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Unique Client IPs",
      "datasource": "Loki",
      "targets": [
        {
          "refId": "A",
          "expr": "count((sum by (remote_addr) (count_over_time({job=\"nginx-access\", host=~\"${host:regex}\", method=~\"${method:regex}\"} !~ \"${exclude_monitoring_line_regex}\" | pattern \"<remote_addr> - <remote_user> [<time_local>] \\\"<parsed_method> <request> <protocol>\\\" <status> <body_bytes_sent> \\\"<http_referer>\\\" \\\"<http_user_agent>\\\"<_>\" [$__range]))) or (sum by (remote_addr) (count_over_time({namespace=\"traefik-v2\", container=\"traefik\"} |~ \"stdout F [0-9.:]+ - - \\\\[\" | pattern \"<_> stdout F <remote_addr> - - [<time_local>] \\\"<parsed_method> <request> <protocol>\\\" <status> <body_bytes_sent> \\\"<http_referer>\\\" \\\"<http_user_agent>\\\" <request_count> \\\"<router>\\\" \\\"<service_url>\\\" <request_duration>\" | request !~ \"${exclude_monitoring_request_regex}\" | router !~ \"${exclude_monitoring_router_regex}\" [$__range]))))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests per Second",
      "datasource": "Loki",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host) (rate({job=\"nginx-access\", host=~\"${host:regex}\", method=~\"${method:regex}\"} [$__interval]))",
          "legendFormat": "nginx {{host}}"
        },
        {
          "refId": "B",
          "expr": "vector(0)",
          "legendFormat": "traefik {{router}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
