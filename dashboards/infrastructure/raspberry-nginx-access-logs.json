{
  "id": null,
  "uid": "raspberry-nginx-access",
  "title": "Raspberry Pi nginx Access Logs",
  "tags": [
    "infrastructure",
    "logs",
    "loki",
    "nginx",
    "raspberry"
  ],
  "timezone": "browser",
  "schemaVersion": 42,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": "Loki",
        "query": "label_values({job=\"nginx-access\"}, host)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        }
      },
      {
        "name": "method",
        "label": "Method",
        "type": "query",
        "datasource": "Loki",
        "query": "label_values({job=\"nginx-access\", host=~\"$host\"}, method)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Requests",
      "datasource": "Loki",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"nginx-access\", host=~\"$host\", method=~\"$method\"}[$__range]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "4xx + 5xx Requests",
      "datasource": "Loki",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"nginx-access\", host=~\"$host\", method=~\"$method\", status=~\"4..|5..\"}[$__range]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error Rate",
      "datasource": "Loki",
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(count_over_time({job=\"nginx-access\", host=~\"$host\", method=~\"$method\", status=~\"4..|5..\"}[$__range])) / clamp_min(sum(count_over_time({job=\"nginx-access\", host=~\"$host\", method=~\"$method\"}[$__range])), 1)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Unique Client IPs",
      "datasource": "Loki",
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (remote_addr) (count_over_time({job=\"nginx-access\", host=~\"$host\", method=~\"$method\"} | pattern \"<remote_addr> - <remote_user> [<time_local>] \\\"<parsed_method> <request> <protocol>\\\" <status> <body_bytes_sent> \\\"<http_referer>\\\" \\\"<http_user_agent>\\\"\" [$__range])))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests per Second by Host",
      "datasource": "Loki",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host) (rate({job=\"nginx-access\", host=~\"$host\", method=~\"$method\"}[$__interval]))",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "4xx and 5xx per Second",
      "datasource": "Loki",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host, status) (rate({job=\"nginx-access\", host=~\"$host\", method=~\"$method\", status=~\"4..|5..\"}[$__interval]))",
          "legendFormat": "{{host}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Status Code Breakdown",
      "datasource": "Loki",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (count_over_time({job=\"nginx-access\", host=~\"$host\", method=~\"$method\"}[$__range]))"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "always"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 13
      }
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Method Breakdown",
      "datasource": "Loki",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method) (count_over_time({job=\"nginx-access\", host=~\"$host\", method=~\"$method\"}[$__range]))"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "always"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 13
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Top Request Paths",
      "datasource": "Loki",
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (request) (count_over_time({job=\"nginx-access\", host=~\"$host\", method=~\"$method\"} | pattern \"<remote_addr> - <remote_user> [<time_local>] \\\"<parsed_method> <request> <protocol>\\\" <status> <body_bytes_sent> \\\"<http_referer>\\\" \\\"<http_user_agent>\\\"\" [$__range])))",
          "legendFormat": "{{request}}"
        }
      ],
      "options": {
        "showHeader": true
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 13
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Top Client IPs",
      "datasource": "Loki",
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (remote_addr) (count_over_time({job=\"nginx-access\", host=~\"$host\", method=~\"$method\"} | pattern \"<remote_addr> - <remote_user> [<time_local>] \\\"<parsed_method> <request> <protocol>\\\" <status> <body_bytes_sent> \\\"<http_referer>\\\" \\\"<http_user_agent>\\\"\" [$__range])))",
          "legendFormat": "{{remote_addr}}"
        }
      ],
      "options": {
        "showHeader": true
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Live Access Log Stream",
      "datasource": "Loki",
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"nginx-access\", host=~\"$host\", method=~\"$method\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      }
    }
  ]
}
