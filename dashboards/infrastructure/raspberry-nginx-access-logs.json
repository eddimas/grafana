{
  "id": null,
  "uid": "raspberry-nginx-access",
  "title": "Raspberry Pi nginx Access Logs",
  "tags": ["infrastructure", "logs", "loki", "nginx", "raspberry"],
  "timezone": "browser",
  "schemaVersion": 42,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": "Loki",
        "query": "label_values({job=\"nginx-access\"}, host)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        }
      },
      {
        "name": "method",
        "label": "HTTP Method",
        "type": "query",
        "datasource": "Loki",
        "query": "label_values({job=\"nginx-access\", host=~\"${host:regex}\"}, method)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Requests",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"nginx-access\", host=~\"${host:regex}\", method=~\"${method:regex}\"} [$__range]))",
          "refId": "A",
          "legendFormat": "Total"
        }
      ]
    },
    {
      "id": 2,
      "title": "Requests by Status Code",
      "type": "piechart",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "sum by (status) (count_over_time({job=\"nginx-access\", host=~\"${host:regex}\", method=~\"${method:regex}\"} [$__range]))",
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Requests Over Time",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 6},
      "targets": [
        {
          "expr": "sum by (method) (rate({job=\"nginx-access\", host=~\"${host:regex}\", method=~\"${method:regex}\"} [$__interval]))",
          "refId": "A",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Top Request Paths",
      "type": "table",
      "gridPos": {"x": 0, "y": 10, "w": 12, "h": 6},
      "targets": [
        {
          "expr": "topk(10, sum by (request) (count_over_time({job=\"nginx-access\", host=~\"${host:regex}\", method=~\"${method:regex}\"} | pattern \"<remote_addr> - <remote_user> [<time_local>] \\\"<parsed_method> <request> <protocol>\\\" <status> <body_bytes_sent> \\\"<http_referer>\\\" \\\"<http_user_agent>\\\"<_>\" [$__range])))",
          "refId": "A",
          "format": "table",
          "legendFormat": "{{request}}"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {
              "Time": "Timestamp",
              "request": "Path",
              "Value": "Count"
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Top Client IPs",
      "type": "table",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 6},
      "targets": [
        {
          "expr": "topk(10, sum by (remote_addr) (count_over_time({job=\"nginx-access\", host=~\"${host:regex}\", method=~\"${method:regex}\"} | pattern \"<remote_addr> - <remote_user> [<time_local>] \\\"<parsed_method> <request> <protocol>\\\" <status> <body_bytes_sent> \\\"<http_referer>\\\" \\\"<http_user_agent>\\\"<_>\" [$__range])))",
          "refId": "A",
          "format": "table",
          "legendFormat": "{{remote_addr}}"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {
              "Time": "Timestamp",
              "remote_addr": "IP",
              "Value": "Count"
            }
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "Live Log Stream",
      "type": "logs",
      "gridPos": {"x": 0, "y": 22, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "{job=\"nginx-access\", host=~\"${host:regex}\", method=~\"${method:regex}\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
