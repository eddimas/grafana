{
  "id": null,
  "uid": "raspberry-nginx-access",
  "title": "Raspberry Pi nginx Access Logs",
  "tags": [
    "infrastructure",
    "logs",
    "loki",
    "nginx",
    "raspberry"
  ],
  "timezone": "browser",
  "schemaVersion": 42,
  "version": 3,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "source",
        "label": "Source",
        "type": "custom",
        "query": "nginx,traefik,all",
        "current": {
          "selected": true,
          "text": "all",
          "value": "nginx|traefik"
        },
        "options": [
          {
            "selected": false,
            "text": "nginx",
            "value": "nginx"
          },
          {
            "selected": false,
            "text": "traefik",
            "value": "traefik"
          },
          {
            "selected": true,
            "text": "all",
            "value": "nginx|traefik"
          }
        ]
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": "Loki",
        "query": "label_values({job=\"nginx-access\"}, host)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "raspberrypi-prod",
          "value": "raspberrypi-prod"
        }
      },
      {
        "name": "method",
        "label": "Method",
        "type": "query",
        "datasource": "Loki",
        "query": "label_values({job=\"nginx-access\", host=~\"$host\"}, method)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        }
      },
      {
        "name": "exclude_monitoring_request_regex",
        "type": "constant",
        "hide": 2,
        "query": ".*(/api/ds/query|/api/login/ping|/api/live/ws|/api/annotations|/api/plugins|/api/prometheus/|/api/datasources/uid/.*/resources/label/|/apis/|dashboardUID=raspberry-nginx-access|/loki/api/v1/|/ready|/metrics).*",
        "current": {
          "selected": false,
          "text": ".*(/api/ds/query|/api/login/ping|/api/live/ws|/api/annotations|/api/plugins|/api/prometheus/|/api/datasources/uid/.*/resources/label/|/apis/|dashboardUID=raspberry-nginx-access|/loki/api/v1/|/ready|/metrics).*",
          "value": ".*(/api/ds/query|/api/login/ping|/api/live/ws|/api/annotations|/api/plugins|/api/prometheus/|/api/datasources/uid/.*/resources/label/|/apis/|dashboardUID=raspberry-nginx-access|/loki/api/v1/|/ready|/metrics).*"
        }
      },
      {
        "name": "exclude_monitoring_router_regex",
        "type": "constant",
        "hide": 2,
        "query": ".*(tlanexli|grafana|prometheus|loki|alloy|monitor).*",
        "current": {
          "selected": false,
          "text": ".*(tlanexli|grafana|prometheus|loki|alloy|monitor).*",
          "value": ".*(tlanexli|grafana|prometheus|loki|alloy|monitor).*"
        }
      },
      {
        "name": "exclude_monitoring_line_regex",
        "type": "constant",
        "hide": 2,
        "query": ".*(tlanexli|/api/ds/query|/api/login/ping|/api/live/ws|/api/annotations|/api/plugins|/api/prometheus/|/api/datasources/uid/.*/resources/label/|/apis/|dashboardUID=raspberry-nginx-access|/loki/api/v1/|/ready|/metrics|grafana|prometheus|loki|alloy).*",
        "current": {
          "selected": false,
          "text": ".*(tlanexli|/api/ds/query|/api/login/ping|/api/live/ws|/api/annotations|/api/plugins|/api/prometheus/|/api/datasources/uid/.*/resources/label/|/apis/|dashboardUID=raspberry-nginx-access|/loki/api/v1/|/ready|/metrics|grafana|prometheus|loki|alloy).*",
          "value": ".*(tlanexli|/api/ds/query|/api/login/ping|/api/live/ws|/api/annotations|/api/plugins|/api/prometheus/|/api/datasources/uid/.*/resources/label/|/apis/|dashboardUID=raspberry-nginx-access|/loki/api/v1/|/ready|/metrics|grafana|prometheus|loki|alloy).*"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Requests",
      "datasource": "Loki",
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(count_over_time({job=\"nginx-access\", host=~\"${host:regex}\", method=~\"${method:regex}\"} !~ \"${exclude_monitoring_line_regex}\" [$__range])) or vector(0))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "4xx Requests",
      "datasource": "Loki",
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(count_over_time({job=\"nginx-access\", host=~\"${host:regex}\", method=~\"${method:regex}\", status=~\"4..\"} !~ \"${exclude_monitoring_line_regex}\" [$__range])) or vector(0))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      }
    },
