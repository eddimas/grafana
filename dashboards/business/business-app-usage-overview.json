{
  "id": null,
  "uid": "business-app-usage",
  "title": "Business App Usage Overview",
  "tags": [
    "business",
    "usage",
    "immich",
    "passbolt",
    "mishtli",
    "kong"
  ],
  "timezone": "browser",
  "schemaVersion": 42,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Business App Traffic (req/s)",
      "type": "stat",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traefik_service_requests_total{service=~\"immich-.*\"}[5m])) or vector(0)",
          "legendFormat": "Immich"
        },
        {
          "refId": "B",
          "expr": "sum(rate(traefik_service_requests_total{service=~\"passbolt-.*\"}[5m])) or vector(0)",
          "legendFormat": "Passbolt"
        },
        {
          "refId": "C",
          "expr": "sum(rate(traefik_service_requests_total{service=~\"mishtli-.*\"}[5m])) or vector(0)",
          "legendFormat": "Mishtli"
        },
        {
          "refId": "D",
          "expr": "sum(rate(traefik_service_requests_total{service=~\"kong-.*\"}[5m])) or vector(0)",
          "legendFormat": "Kong"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Immich Registered Users",
      "type": "stat",
      "targets": [
        {
          "refId": "A",
          "expr": "max(immich_users_total{job=\"immich-api\"}) or vector(0)",
          "legendFormat": "users"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "Immich API Success Rate",
      "type": "stat",
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * sum(rate(http_server_response_success_count_total{job=\"immich-api\"}[5m])) / clamp_min(sum(rate(http_server_response_count_total{job=\"immich-api\"}[5m])), 1)) or vector(0)",
          "legendFormat": "success"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 0
      }
    },
    {
      "id": 4,
      "title": "Immich New Assets / Hour",
      "type": "stat",
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(immich_asset_repository_create_duration_count[15m])) * 3600) or vector(0)",
          "legendFormat": "assets/hour"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      }
    },
    {
      "id": 5,
      "title": "Requests by App",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traefik_service_requests_total{service=~\"immich-.*\"}[5m]))",
          "legendFormat": "Immich"
        },
        {
          "refId": "B",
          "expr": "sum(rate(traefik_service_requests_total{service=~\"passbolt-.*\"}[5m]))",
          "legendFormat": "Passbolt"
        },
        {
          "refId": "C",
          "expr": "sum(rate(traefik_service_requests_total{service=~\"mishtli-.*\"}[5m]))",
          "legendFormat": "Mishtli"
        },
        {
          "refId": "D",
          "expr": "sum(rate(traefik_service_requests_total{service=~\"kong-.*\"}[5m]))",
          "legendFormat": "Kong"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 6,
      "title": "Immich API Requests by Method",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_count_total{job=\"immich-api\", method=\"GET\"}[5m]))",
          "legendFormat": "GET"
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_server_request_count_total{job=\"immich-api\", method=\"POST\"}[5m]))",
          "legendFormat": "POST"
        },
        {
          "refId": "C",
          "expr": "sum(rate(http_server_request_count_total{job=\"immich-api\", method=\"PUT\"}[5m]))",
          "legendFormat": "PUT"
        },
        {
          "refId": "D",
          "expr": "sum(rate(http_server_request_count_total{job=\"immich-api\", method=\"DELETE\"}[5m]))",
          "legendFormat": "DELETE"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      }
    },
    {
      "id": 7,
      "title": "Immich Business Activity",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(immich_asset_repository_create_duration_count[15m])) * 3600",
          "legendFormat": "New Assets / Hour"
        },
        {
          "refId": "B",
          "expr": "sum(rate(immich_album_repository_add_assets_duration_count[15m])) * 3600",
          "legendFormat": "Album Asset Adds / Hour"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      }
    },
    {
      "id": 8,
      "title": "Edge Traffic by App",
      "type": "table",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traefik_service_requests_total{service=~\"immich-.*\"}[5m]))",
          "legendFormat": "Immich"
        },
        {
          "refId": "B",
          "expr": "sum(rate(traefik_service_requests_total{service=~\"passbolt-.*\"}[5m]))",
          "legendFormat": "Passbolt"
        },
        {
          "refId": "C",
          "expr": "sum(rate(traefik_service_requests_total{service=~\"mishtli-.*\"}[5m]))",
          "legendFormat": "Mishtli"
        },
        {
          "refId": "D",
          "expr": "sum(rate(traefik_service_requests_total{service=~\"kong-.*\"}[5m]))",
          "legendFormat": "Kong"
        }
      ],
      "transformations": [
        {
          "id": "seriesToRows",
          "options": {
            "reducers": []
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      }
    },
    {
      "id": 9,
      "title": "Immich Read vs Write Mix",
      "type": "stat",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_count_total{job=\"immich-api\", method=\"GET\"}[5m])) or vector(0)",
          "legendFormat": "Reads"
        },
        {
          "refId": "B",
          "expr": "(sum(rate(http_server_request_count_total{job=\"immich-api\", method=\"POST\"}[5m])) + sum(rate(http_server_request_count_total{job=\"immich-api\", method=\"PUT\"}[5m])) + sum(rate(http_server_request_count_total{job=\"immich-api\", method=\"DELETE\"}[5m]))) or vector(0)",
          "legendFormat": "Writes"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 21
      }
    },
    {
      "id": 10,
      "title": "Immich Average Response Size",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_response_size_sum{job=\"immich-api\"}[5m])) / clamp_min(sum(rate(http_server_response_size_count{job=\"immich-api\"}[5m])), 1)",
          "legendFormat": "Avg Response Size"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 21
      }
    }
  ]
}
