{
  "id": null,
  "title": "Immich Application Dashboard",
  "tags": [
    "kubernetes",
    "applications",
    "immich"
  ],
  "timezone": "browser",
  "schemaVersion": 30,
  "version": 2,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Immich Running Pods",
      "type": "stat",
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{namespace=\"immich-dev\", phase=\"Running\"}) or vector(0)",
          "legendFormat": "Running Pods"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Immich Deployments",
      "type": "stat",
      "targets": [
        {
          "expr": "count(kube_deployment_status_replicas_available{namespace=\"immich-dev\"}) or vector(0)",
          "legendFormat": "Deployments"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Immich Services",
      "type": "stat",
      "targets": [
        {
          "expr": "count(kube_service_info{namespace=\"immich-dev\"}) or vector(0)",
          "legendFormat": "Services"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Immich PVCs Bound",
      "type": "stat",
      "targets": [
        {
          "expr": "count(kube_persistentvolumeclaim_status_phase{namespace=\"immich-dev\", phase=\"Bound\"}) or vector(0)",
          "legendFormat": "Bound PVCs"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      }
    },
    {
      "id": 5,
      "title": "Running Pods by Immich Pod",
      "type": "graph",
      "targets": [
        {
          "expr": "sum by (pod) (kube_pod_status_phase{namespace=\"immich-dev\", phase=\"Running\"})",
          "legendFormat": "{{pod}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "yAxes": [
        {
          "min": 0,
          "label": "Pod Count"
        }
      ]
    },
    {
      "id": 6,
      "title": "Immich Deployment Replicas Status",
      "type": "table",
      "targets": [
        {
          "expr": "kube_deployment_status_replicas{namespace=\"immich-dev\"}",
          "legendFormat": "{{namespace}}/{{deployment}} - Desired"
        },
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"immich-dev\"}",
          "legendFormat": "{{namespace}}/{{deployment}} - Available"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      }
    },
    {
      "id": 7,
      "title": "Immich Restart Count (Last Hour)",
      "type": "graph",
      "targets": [
        {
          "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"immich-dev\"}[1h]))",
          "legendFormat": "{{pod}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "yAxes": [
        {
          "min": 0,
          "label": "Restart Count"
        }
      ]
    },
    {
      "id": 8,
      "title": "Immich Service Status",
      "type": "table",
      "targets": [
        {
          "expr": "kube_service_info{namespace=\"immich-dev\"}",
          "legendFormat": "{{namespace}}/{{service}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      }
    },
    {
      "id": 9,
      "title": "Immich Pod Memory Limits",
      "type": "graph",
      "targets": [
        {
          "expr": "sum by (pod) (kube_pod_container_resource_limits{namespace=\"immich-dev\", resource=\"memory\"})",
          "legendFormat": "{{pod}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 22
      },
      "yAxes": [
        {
          "min": 0,
          "label": "Memory (bytes)"
        }
      ]
    },
    {
      "id": 10,
      "title": "Immich Pod CPU Limits",
      "type": "graph",
      "targets": [
        {
          "expr": "sum by (pod) (kube_pod_container_resource_limits{namespace=\"immich-dev\", resource=\"cpu\"})",
          "legendFormat": "{{pod}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 22
      },
      "yAxes": [
        {
          "min": 0,
          "label": "CPU (cores)"
        }
      ]
    },
    {
      "id": 11,
      "title": "Immich ConfigMaps & Secrets",
      "type": "stat",
      "targets": [
        {
          "expr": "count(kube_configmap_info{namespace=\"immich-dev\"}) or vector(0)",
          "legendFormat": "ConfigMaps"
        },
        {
          "expr": "count(kube_secret_info{namespace=\"immich-dev\"}) or vector(0)",
          "legendFormat": "Secrets"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 22
      }
    },
    {
      "id": 12,
      "title": "Immich Microservices Memory Usage % of Limit",
      "type": "graph",
      "targets": [
        {
          "expr": "100 * sum by (pod) (container_memory_working_set_bytes{namespace=\"immich-dev\", pod=~\"immich-microservices-.*\", container!=\"\", image!=\"\"}) / clamp_min(sum by (pod) (kube_pod_container_resource_limits{namespace=\"immich-dev\", pod=~\"immich-microservices-.*\", resource=\"memory\"}), 1)",
          "legendFormat": "{{pod}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "yAxes": [
        {
          "min": 0,
          "max": 100,
          "label": "Percent"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        }
      }
    },
    {
      "id": 13,
      "title": "Immich Pod Working Set Memory",
      "type": "graph",
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"immich-dev\", pod=~\"immich-.*\", container!=\"\", image!=\"\"}) / 1024 / 1024 / 1024",
          "legendFormat": "{{pod}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "yAxes": [
        {
          "min": 0,
          "label": "GiB"
        }
      ]
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  }
}
